# Copy to .env and fill in. These are the only knobs you edit.

# Shown in the app
APP_NAME=Genesis

# >>> module:ai
# LLM (needed only for the Chat demo). One gateway key reaches every provider.
# Default: OpenRouter (https://openrouter.ai) — put your key in LLM_API_KEY and
# switch provider by changing LLM_MODEL only.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# Portkey (or any gateway that needs custom headers): point LLM_BASE_URL at it and
# supply the headers as JSON. Portkey needs x-portkey-api-key plus a virtual key:
# LLM_BASE_URL=https://your-gateway.portkey.ai/v1
# LLM_EXTRA_HEADERS={"x-portkey-api-key":"PORTKEY_KEY","x-portkey-virtual-key":"VIRTUAL_KEY"}
# <<< module:ai

EMAIL_BACKEND=console # module:email
SMTP_HOST= # module:email
SMTP_PORT=587 # module:email
SMTP_USER= # module:email
SMTP_PASSWORD= # module:email
EMAIL_FROM= # module:email

STORAGE_BACKEND=local # module:storage
STORAGE_LOCAL_PATH=/data/storage # module:storage
STORAGE_S3_BUCKET= # module:storage
STORAGE_S3_ENDPOINT= # module:storage
STORAGE_S3_ACCESS_KEY= # module:storage
STORAGE_S3_SECRET_KEY= # module:storage

AUTH_SECRET=genesis-dev-secret-change-me # module:auth
ADMIN_EMAILS= # module:auth

# Passwords for the bundled database and dashboards
POSTGRES_PASSWORD=genesis
O2_ROOT_PASSWORD=genesis-admin




